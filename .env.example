# ==============================================================================
# Environment Variables Configuration
# Copy this file to `.env` (or configure in Vercel Project Settings)
# Never commit real credentials or secrets to version control.
# ==============================================================================

# Contact Form & Email Provider Configuration
# ------------------------------------------------------------------------------
# Replace with the confirmed recipient before enabling delivery.
# abc@gmail.com is a placeholder and is deliberately rejected by the API.
CONTACT_RECIPIENT_EMAIL=abc@gmail.com

# Option A: Resend (Recommended on Vercel)
# Sign up at https://resend.com to generate an API key
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Option B: SendGrid (Alternative provider)
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# SENDGRID_FROM_EMAIL=your_verified_sender@example.com

# Option C: Custom Webhook (e.g., Slack, Discord, or custom microservice)
# CONTACT_WEBHOOK_URL=https://your-webhook-endpoint.com/api/contact

# Max contact submissions allowed per IP per 10-minute window (default: 5)
CONTACT_RATE_LIMIT=5

# RAG Chatbot LLM Provider Configuration
# ------------------------------------------------------------------------------
# Option A: OpenAI (default: gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Option B: Google Gemini (alternative provider)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Security & Limits
# ------------------------------------------------------------------------------
# Max chat queries per IP per minute (default: 15)
RATE_LIMIT_MAX_PER_MINUTE=15

# Max query character length (default: 500)
MAX_QUERY_LENGTH=500

# Local Server Configuration
# ------------------------------------------------------------------------------
PORT=8000
